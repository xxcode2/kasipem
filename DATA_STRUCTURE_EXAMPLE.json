  "common_validation_rules": {
    "nik": {
      "pattern": "^\\d{16}$",
      "description": "16 digit numeric",
      "example": "3213266804990001"
    },
    "nama": {
      "pattern": "^[A-Z][A-Z\\s\\.\\-]{2,98}[A-Z]$",
      "description": "3-100 chars, uppercase, alphanumeric with space/dash/dot",
      "example": "SUMARNI APRIANTINI"
    },
    "ttl": {
      "pattern": "^[A-Za-z\\s]+,\\s\\d{2}-\\d{2}-\\d{4}$",
      "description": "Format: Place, DD-MM-YYYY",
      "example": "Subang, 27-04-1997"
    },
    "alamat": {
      "minLength": 10,
      "maxLength": 200,
      "description": "Full address with Rt/Rw, Village, District, Regency",
      "example": "Kp Sukajaya Rt 002 Rw 005 Desa Kasomalang Kulon Kecamatan Kasomalang Kabupaten Subang"
    },
    "nomor_surat": {
      "pattern": "^\\d{1,3}\\s*/\\s*\\d{0,2}\\s*/\\s*[A-Za-z]+\\s*/\\s*\\d{4}$",
      "description": "Format: XXX / XX / CATEGORY / YEAR",
      "example": "474 / / PEM / 2026"
    },
    "luas": {
      "type": "number",
      "min": 1,
      "max": 99999,
      "unit": "m²",
      "example": "153"
    },
    "harga": {
      "type": "currency",
      "currency": "IDR",
      "format": "XXX.XXX.XXX",
      "example": "100.000.000"
    }
  },
  "letter_categories": {
    "individual": [1, 2, 6, 7, 10, 11],
    "comparison": [3, 5],
    "table": [4, 8],
    "special": [9, 12]
  }
}
